# Copy to server/.env and replace the placeholders. Never commit the real .env.

# Required
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/liftlogic"
JWT_SECRET="replace-with-a-long-random-string"

# Optional: KevAi answers fail without it (the server warns at startup)
OPENAI_API_KEY=""

# Optional: defaults shown
PORT=5000
# Comma-separated list of sites allowed to call the API. Add the deployed
# client's origin here, e.g. "http://localhost:5173,https://your-name.github.io"
CLIENT_ORIGIN="http://localhost:5173"
