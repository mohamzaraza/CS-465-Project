datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================
// ENUMS
// =========================

// This is correct — KEEP these.
enum StrengthTier {
  UNTRAINED
  RECRUIT
  NOVICE
  WARRIOR
  HEROIC
  CHAMPION
  TITAN
  OLYMPIAN
  DIVINE
  CELESTIAL
  IMMORTAL
  PRIMORDIAL
}

enum MasteryLevel {
  UNTRAINED
  DISCIPLINED
  FULL_MASTERY
  ASCENDED
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  QUADS
  HAMSTRINGS
  BICEPS
  TRICEPS
  FOREARMS
  ABS
  OBLIQUES
  CALVES
  GLUTES
  LOWER_BACK
}

// =========================
// MODELS
// =========================

// ==== USERS ====
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  // Relations
  muscleMasteries MuscleMastery[]
  muscleRanks     MuscleRank[]
  liftLogs        UserLiftsLog[]
}

// ==== PER-MUSCLE MASTERY TRACKING ====
model MuscleMastery {
  id String @id @default(uuid())

  muscle    MuscleGroup // ENUM — not string
  mastery   MasteryLevel // ENUM — not string
  progress  Int          @default(0)
  updatedAt DateTime     @updatedAt

  // Relation to user
  userId String
  user   User   @relation(fields: [userId], references: [id])
}

// ==== PER-MUSCLE RANK (TIER) ====
model MuscleRank {
  id String @id @default(uuid())

  muscle    MuscleGroup // ENUM
  tier      StrengthTier // ENUM
  score     Int
  updatedAt DateTime     @updatedAt

  // Relation to user
  userId String
  user   User   @relation(fields: [userId], references: [id])
}

// ==== LIFT LOGS ====
model UserLiftsLog {
  id String @id @default(uuid())

  userId    String
  muscle    MuscleGroup // ENUM
  liftName  String
  weight    Float
  reps      Int
  timestamp DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])
}
